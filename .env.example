# Discord Music Bot Configuration
# Copy this file to '.env' and fill in your actual settings.
# There are NO hard-coded default values for credentials or secrets.

# 1. Discord Settings
# Bot token from the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name
DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/your_db_name?sslmode=disable

# 3. Redis Connection Settings
REDIS_ADDR=your_redis_host:6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# 4. MinIO S3-Compatible Object Storage Settings
MINIO_ENDPOINT=your_minio_host:9000
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=musicbot-library
MINIO_USE_SSL=false

# 5. Spotify API Credentials (Optional)
# Leave these empty if you do not want Spotify link support. It will fall back to YouTube search.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# 6. SMTP Email Notification Settings
# Used to send notification emails to the administrator for custom song approvals.
SMTP_HOST=your_smtp_server_here
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com
